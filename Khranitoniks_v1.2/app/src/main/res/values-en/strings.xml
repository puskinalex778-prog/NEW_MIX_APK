    <string name="vendor_huawei">Huawei/Honor: Settings → Battery → App launch → Хранитоникс → Manage manually and turn on all 3 switches. Admins: Settings → Security → More settings → Device administrators.</string>
    <string name="vendor_infinix">Infinix/Tecno: Phone Master → Auto-start → enable Хранитоникс; Settings → Battery → Хранитоникс → No restrictions. Admins: Settings → Security → Device admin apps.</string>
    <string name="vendor_other">Allow auto-start and background activity for Хранитоникс in your phone\'s battery settings.</string>
    <string name="vendor_samsung">Samsung: Settings → Battery → Background usage limits → Never sleeping apps → add Хранитоникс. Admins: Settings → Security and privacy → Other security settings → Device admin apps.</string>
    <string name="vendor_xiaomi">Xiaomi/Redmi/POCO: Security → Permissions → Autostart → Хранитоникс; Settings → Apps → Хранитоникс → Battery saver → No restrictions.</string>
